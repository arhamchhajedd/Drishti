# Drishti AI Environment Variables
# Copy to .env.local and fill in. Never commit real values.

GEMINI_API_KEY=
# Fast vision model for live use. Check availability with your key if you change it.
GEMINI_MODEL=gemini-3.5-flash-lite
# MINIMAL | LOW | MEDIUM | HIGH (some models reject MINIMAL; use LOW for those)
GEMINI_THINKING_LEVEL=MINIMAL
# Optional: salt for hashing IPs in the in-memory rate limiter
RATE_LIMIT_SALT=
